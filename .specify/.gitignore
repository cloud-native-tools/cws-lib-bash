# Framework-owned .specify-scoped ignore rules.
# Installed by `specify init` as .specify/.gitignore. Patterns are relative to
# .specify/; the project-root .gitignore must not duplicate them.

# /speckit.history scratch (de-noised transcripts); .md docs + .manifest.json are tracked
history/.work/

# /speckit.team run intermediate workspace (transient); team defs + runs/ reports stay tracked
teams/.work/

# Agent Execution runtime logs (agent-definitions.md layer 3); configs/ and scripts/ stay tracked
agents/execution/logs/

# Tool discovery inventories (machine-generated by generate-instructions.sh);
# canonical definitions live in memory/tools/
tools/

# Instructions backups (time-stamped, regenerated); current instructions.md is tracked
instructions.md-*

# Sanitize findings ledger (machine-regenerable runtime cache; dogfood evidence
# lives in the spec's verification.md)
memory/sanitize/

# Proactive-flow per-turn telemetry (churns every turn); learning state
# memory/trigger/index.json stays tracked
memory/trigger/telemetry.jsonl

# Agent-created scratch (temp-directory discipline); cleaned up when the work item completes
.tmp/
